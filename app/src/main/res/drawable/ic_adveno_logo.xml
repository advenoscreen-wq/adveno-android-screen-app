<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="72dp"
    android:height="72dp"
    android:viewportWidth="72"
    android:viewportHeight="72">

    <!-- Ambient Shadow/Glow -->
    <path
        android:fillColor="#338B5CF6"
        android:pathData="M24,14 L56,33 C61,36 61,42 56,45 L24,64 C18,67 12,63 12,57 L12,21 C12,15 18,11 24,14 Z" />

    <!-- Main Triangular Ribbon -->
    <path
        android:pathData="M22,12 L54,31 C59,34 59,40 54,43 L22,62 C16,65 10,61 10,55 L10,19 C10,13 16,9 22,12 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="10"
                android:startY="10"
                android:endX="62"
                android:endY="62">
                <item android:color="#A855F7" android:offset="0.0" />
                <item android:color="#6366F1" android:offset="0.45" />
                <item android:color="#3478F6" android:offset="0.8" />
                <item android:color="#22D3EE" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Cutout/Loop for 3D Ribbon Feel -->
    <path
        android:fillColor="#101522"
        android:pathData="M22,25 L41,36 L22,47 Z" />

    <!-- Highlight Reflection on Upper Edge -->
    <path
        android:pathData="M22,12 L54,31 C56,32 57,34 57,36 C55,34 43,27 22,15 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="22"
                android:startY="12"
                android:endX="57"
                android:endY="36">
                <item android:color="#C084FC" android:offset="0.0" />
                <item android:color="#818CF8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>

